# Copy this file to .env and fill in your own keys. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=
# Hugging Face token (read access) from https://huggingface.co/settings/tokens
HF_TOKEN=
# LangSmith key from https://smith.langchain.com (Settings > API Keys)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=support-triage-agent

# Chat model in LangChain "provider:model" format.
# gemini-3.5-flash-lite: stable, free-tier, and has the most generous free quota of the Flash family.
CHAT_MODEL=google_genai:gemini-3.5-flash-lite

# Local embedding model (runs on CPU, no API key needed).
# all-MiniLM-L6-v2: small (~90 MB, 384-dim vectors), fast on CPU, and one of the
# most widely used sentence-transformers models. Good quality for short texts
# like customer messages.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
